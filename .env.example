# Variables for docker-compose.yml (copy to ".env" next to docker-compose.yml).
# Backend settings themselves live in backend/.env.

# Uncomment when running: docker compose --profile monitoring up -d
# PROMETHEUS_URL=http://prometheus:9090
# GRAFANA_URL=http://localhost:3000
# GRAFANA_ADMIN_PASSWORD=change-me

# Linux only: group id of the Docker socket (getent group docker | cut -d: -f3)
# DOCKER_GID=999

# Install boto3 in the backend image for the AWS panel
# INSTALL_AWS=true
