# =====================================================================
# DevOps AI Dashboard - backend configuration
# Copy this file to ".env" (same folder) and fill in values step by step.
# Every integration stays "Not configured" until its section is filled,
# so you can add tools one phase at a time (see docs/PHASES.md).
# NEVER commit the real .env file - it contains secrets.
# =====================================================================

# ---------- General ----------
APP_ENV=development
# Browser origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow buttons that change things (restart container, trigger build, ...)
ALLOW_ACTIONS=true

# ---------- Phase 1: System monitoring (psutil) ----------
SAMPLE_INTERVAL=5
HISTORY_SIZE=720
INTEGRATION_POLL_INTERVAL=60

# ---------- Phase 2: AI assistant (Google Gemini) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---------- Phase 3: Logs ----------
# Whitelisted log files: name=path;name2=path2
# Windows example: LOG_FILES=nginx=C:\nginx\logs\error.log
# Linux example:   LOG_FILES=nginx=/var/log/nginx/error.log;auth=/var/log/auth.log
LOG_FILES=

# ---------- Phase 4: Alerts ----------
ALERT_CPU_THRESHOLD=85
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90
# A breach must last this many samples (x SAMPLE_INTERVAL seconds) before firing
ALERT_FOR_SAMPLES=3
# Optional Slack / Discord incoming webhook
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack

# ---------- Phase 5: Docker ----------
DOCKER_ENABLED=false

# ---------- Phase 6: CI/CD ----------
# GitHub Actions: comma separated owner/repo list + fine-grained token (Actions: read)
GITHUB_REPOS=
GITHUB_TOKEN=
# Jenkins: URL + user + API token (Jenkins > your name > Security > API Token)
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ---------- Phase 7: Prometheus + Grafana ----------
PROMETHEUS_URL=
GRAFANA_URL=

# ---------- Phase 8: Kubernetes (Minikube) ----------
KUBERNETES_ENABLED=false
# Leave empty to use the current kubectl context (minikube sets it)
KUBE_CONTEXT=

# ---------- Phase 10: AWS (optional, needs requirements-aws.txt) ----------
AWS_ENABLED=false
AWS_REGION=ap-south-1
